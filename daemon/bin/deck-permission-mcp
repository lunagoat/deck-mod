#!/usr/bin/env python3
"""MCP server (stdio) that lets a headless `claude -p` ask the person in deck for permission.

Claude is started with `--permission-prompt-tool mcp__deck__approve`; whenever it wants to use a tool
that isn't already allowed, it calls `approve` here. We forward the question over deck's unix socket,
deck shows a confirm/deny dialog, and we hand the answer back as Claude expects:
  {"behavior": "allow", "updatedInput": {...}}  or  {"behavior": "deny", "message": "..."}
"""
import json
import os
import socket
import sys

TOOL = {
    "name": "approve",
    "description": "Ask the user in deck whether a tool call may run.",
    "inputSchema": {
        "type": "object",
        "properties": {"tool_name": {"type": "string"}, "input": {"type": "object"},
                       "tool_use_id": {"type": "string"}},
        "required": ["tool_name", "input"],
    },
}


def ask_deck(args: dict) -> dict:
    path = os.environ.get("DECK_SOCK")
    if not path:
        return {"behavior": "deny", "message": "not running inside deck, so nobody can approve this"}
    try:
        s = socket.socket(socket.AF_UNIX)
        s.connect(path)
        req = {"op": "permission", "from": int(os.environ.get("DECK_RUN", 0)),
               "tool": args.get("tool_name", "?"), "input": args.get("input", {})}
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf)
    except (OSError, ValueError) as e:
        return {"behavior": "deny", "message": f"deck could not be reached: {e}"}  # fail closed


def reply(msg_id, result=None, error=None):
    out = {"jsonrpc": "2.0", "id": msg_id}
    out.update({"error": error} if error else {"result": result})
    sys.stdout.write(json.dumps(out) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        method, mid = msg.get("method"), msg.get("id")
        if mid is None:  # notifications (initialized, cancelled, ...) need no answer
            continue
        if method == "initialize":
            reply(mid, {"protocolVersion": msg.get("params", {}).get("protocolVersion", "2024-11-05"),
                        "capabilities": {"tools": {}}, "serverInfo": {"name": "deck", "version": "1"}})
        elif method == "tools/list":
            reply(mid, {"tools": [TOOL]})
        elif method == "tools/call":
            params = msg.get("params", {})
            if params.get("name") != "approve":
                reply(mid, error={"code": -32602, "message": "unknown tool"})
                continue
            decision = ask_deck(params.get("arguments", {}))
            if decision.get("behavior") == "allow" and "updatedInput" not in decision:
                decision["updatedInput"] = params.get("arguments", {}).get("input", {})
            reply(mid, {"content": [{"type": "text", "text": json.dumps(decision)}]})
        elif method == "ping":
            reply(mid, {})
        else:
            reply(mid, error={"code": -32601, "message": f"unknown method {method}"})


main()
